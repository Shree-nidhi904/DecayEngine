{
  "version": "v1",
  "hooks": [
    {
      "name": "Run engine tests on save",
      "trigger": "PostFileSave",
      "action": {
        "type": "command",
        "command": "pnpm --filter ./packages/engine exec vitest run"
      },
      "description": "Runs the engine test suite whenever a file in packages/engine is saved.",
      "matcher": "packages[\\\\/]engine[\\\\/].*\\.ts$",
      "timeout": 120,
      "enabled": true
    }
  ]
}
