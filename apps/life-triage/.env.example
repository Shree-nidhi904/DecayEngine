# Optional: "Load from my account". Leave both unset and the page makes no network request.
# Copy to .env.local (ignored by git). It is used for local development and for deploys:
# scripts/deploy-cloudflare.sh builds on your machine, so Vite reads this file. The key is the project's
# PUBLISHABLE key; never a secret or service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
